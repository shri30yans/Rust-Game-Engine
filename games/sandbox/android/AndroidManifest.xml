<?xml version="1.0" encoding="utf-8"?>
<!-- Manifest of the sandbox APK. No Java or Kotlin code: the activity is Android's NativeActivity,
     which loads libsandbox.so and calls its android_main. Built by scripts/build-android.sh. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.engine.sandbox">

    <uses-feature android:glEsVersion="0x00030000" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <application android:label="Sandbox" android:hasCode="false">
        <activity android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|smallestScreenSize|screenLayout|uiMode"
            android:screenOrientation="sensorLandscape"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
            <meta-data android:name="android.app.lib_name" android:value="sandbox" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
